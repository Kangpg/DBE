    <Reference Include="EnvDTE80"><HintPath>$(VSAssemblyPath)\envdte80.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="DbePackage.cs"/><Compile Include="ProjectTarget.cs"/><Compile Include="AssemblyInfo.cs"/>
    <VSCTCompile Include="Commands.vsct"><ResourceName>Menus.ctmenu</ResourceName></VSCTCompile>
    <EmbeddedResource Include="VSPackage.resx"><MergeWithCTO>true</MergeWithCTO><LogicalName>VSPackage.resources</LogicalName></EmbeddedResource>
    <None Include="source.extension.vsixmanifest"/>
    <Content Include="$(DBEBuildHostPath)"><Link>dbe-build-host.exe</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><IncludeInVSIX>true</IncludeInVSIX></Content>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets"/>
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets"/>
  <!-- The installed SDK task retains an existing intermediate manifest. Regenerate this
       owned output so edits to version, compatibility and assets reach the VSIX. -->
  <Target Name="RefreshDbeVsixManifest" BeforeTargets="DetokenizeVsixManifestFile">
    <Delete Files="$(IntermediateVsixManifest)" />
  </Target>
</Project>
