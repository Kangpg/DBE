<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(DBEAdapterDirectory)\compiler.props" Condition="'$(DBEEnabled)' == 'true' And Exists('$(DBEAdapterDirectory)\compiler.props')" />
  <UsingTask TaskName="DbeInputInventory" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <Task><Code Type="Class" Source="$(DBEAdapterDirectory)\DbeInputInventory.cs" /></Task>
  </UsingTask>
  <!-- Explicit project import after Microsoft.Cpp.targets. No global environment. -->
  <PropertyGroup Condition="'$(DBEEnabled)' == 'true'">
    <CLToolPath>$(DBEAdapterDirectory)</CLToolPath>
    <CLToolExe>dbe-remote-cl.exe</CLToolExe>
    <!-- The managed adapter emits text. Native Local retains the caller's
         structured diagnostic handles. -->
    <UseClStructuredOutput Condition="'$(DBELocal)' != 'true'">false</UseClStructuredOutput>
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <LinkToolPath Condition="'$(DBEHybrid)' == 'true'">$(DBEAdapterDirectory)</LinkToolPath>
    <LinkToolExe Condition="'$(DBEHybrid)' == 'true'">dbe-link.exe</LinkToolExe>
    <LIBToolPath Condition="'$(DBEHybrid)' == 'true'">$(DBEAdapterDirectory)</LIBToolPath>
    <LIBToolExe Condition="'$(DBEHybrid)' == 'true'">dbe-lib.exe</LIBToolExe>
    <DBEIncrementalTracking Condition="'$(DBEIncrementalTracking)' == '' And ('$(DBEHybrid)' == 'true' Or '$(DBELocal)' == 'true')">true</DBEIncrementalTracking>
    <DBELocalInputs Condition="'$(DBELocal)' == 'true'">$(DBEAdapterDirectory)\dbe-remote-cl.compiler</DBELocalInputs>
    <!-- Newer VC targets consume this property; older ones consume item metadata. -->
    <CLDeleteOutputOnExecute Condition="'$(DBELocal)' == 'true'">true</CLDeleteOutputOnExecute>
    <CLDeleteOutputOnExecute Condition="'$(DBELocal)' != 'true'">false</CLDeleteOutputOnExecute>
  </PropertyGroup>
  <!-- Compile-ahead. A project needs its references' outputs at link time, not to
       compile, so it can compile while they build. The ordinary Build that follows
       still resolves references and links in order, and finds its objects up to date.
       One MSBuild call starts them together on the caller's nodes; the ordinary
       reference step then reuses those results. A failure here is not final: the
       ordinary Build repeats the step in dependency order and reports it. -->
  <PropertyGroup Condition="'$(DBEEnabled)' == 'true' And '$(DBECompileAheadInstance)' == 'true'">
    <BuildDependsOn>PrepareForBuild;ClCompile</BuildDependsOn>
  </PropertyGroup>
  <ItemGroup Condition="'$(DBEEnabled)' == 'true'">
    <DBEDeclaredReference Include="@(ProjectReference)" />
  </ItemGroup>
  <!-- VC's compile targets resolve references first, and asking a reference that
       is mid-Build for its output path would block until that Build ends. -->
  <ItemGroup Condition="'$(DBEEnabled)' == 'true' And '$(DBECompileAheadInstance)' == 'true'">
    <ProjectReference Remove="@(ProjectReference)" />
  </ItemGroup>
  <Target Name="DBECompileAhead" BeforeTargets="ResolveProjectReferences"
          Condition="'$(DBEEnabled)' == 'true' And '$(DBEHybrid)' == 'true' And '$(DBECompileAhead)' != 'false' And '$(DBECompileAheadInstance)' != 'true' And '$(BuildingInsideVisualStudio)' != 'true' And '$(BuildProjectReferences)' != 'false' And '@(_MSBuildProjectReferenceExistent)' != '' And '@(ClCompile)' != ''">
    <ItemGroup>
      <DBEAheadProject Include="@(_MSBuildProjectReferenceExistent)" Condition="'%(_MSBuildProjectReferenceExistent.BuildReference)' == 'true'">
        <Properties>%(_MSBuildProjectReferenceExistent.SetConfiguration);%(_MSBuildProjectReferenceExistent.SetPlatform);%(_MSBuildProjectReferenceExistent.SetTargetFramework)</Properties>
      </DBEAheadProject>
      <DBEAheadProject Include="$(MSBuildProjectFullPath)">
        <Properties>Configuration=$(Configuration);Platform=$(Platform);DBECompileAheadInstance=true;BuildProjectReferences=false</Properties>
      </DBEAheadProject>
    </ItemGroup>
    <MSBuild Projects="@(DBEAheadProject)" BuildInParallel="true" ContinueOnError="true" />
  </Target>
  <!-- CL runs below the launcher. Consolidate its PID-specific child logs
       into a stable canonical log so the next MP pass can clean prior outputs. -->
  <ItemGroup Condition="'$(DBEEnabled)' == 'true' And '$(DBELocal)' == 'true'">
    <CLTLogReadFiles Condition="'@(CLTLogReadFiles)' == ''" Include="$(TLogLocation)dbe-remote-cl.read.1.tlog;$(TLogLocation)dbe-remote-cl-%2A.read.%2A.tlog" />
    <CLTLogWriteFiles Condition="'@(CLTLogWriteFiles)' == ''" Include="$(TLogLocation)dbe-remote-cl.write.1.tlog;$(TLogLocation)dbe-remote-cl-%2A.write.%2A.tlog" />
  </ItemGroup>
  <Target Name="DBEPrepareRemoteCompile" BeforeTargets="ClCompile" Condition="'$(DBEEnabled)' == 'true'">
    <PropertyGroup><DBESelectedCompiler>$([System.IO.Path]::GetFullPath('$(VCToolsInstallDir)bin\Hostx64\x64\cl.exe'))</DBESelectedCompiler></PropertyGroup>
    <!-- Automatic scope: this project's own solution, directory and references. The
         INCLUDE and /I roots reach the adapter through the normal CL invocation. -->
    <PropertyGroup Condition="'$(DBENativeAutoScope)' == 'true'">
      <DBEScopeRoots Condition="'$(SolutionDir)' != '' and '$(SolutionDir)' != '*Undefined*'">$(SolutionDir)</DBEScopeRoots>
      <DBEScopeRoots>$(DBEScopeRoots);$(MSBuildProjectDirectory);@(DBEDeclaredReference->'%(RootDir)%(Directory)')</DBEScopeRoots>
    </PropertyGroup>
    <!-- These roots describe what a Worker may need, not what the membership guard
         watches: a solution directory also holds other projects' generated sources,
         which appear during the build. Files actually read are tracked from tlogs. -->
    <SetEnv Condition="'$(DBENativeAutoScope)' == 'true'" Name="DBE_INPUT_ROOTS" Value="$(DBEScopeRoots)" Prefix="false" />
    <SetEnv Condition="'$(DBECompileAheadInstance)' == 'true'" Name="DBE_COMPILE_AHEAD" Value="1" Prefix="false" />
    <SetEnv Condition="'$(DBECompileAheadInstance)' != 'true'" Name="DBE_COMPILE_AHEAD" Value="0" Prefix="false" />
    <Error Condition="!Exists('$(DBEAdapterDirectory)\dbe-remote-cl.exe') Or !Exists('$(DBEAdapterDirectory)\msbuild.json')" Text="DBEAdapterDirectory must contain the configured MSBuild adapter." />
    <Error Condition="'$(Platform)' != 'x64'" Text="DBE remote adapter currently requires Platform=x64." />
    <Error Condition="'$(PlatformToolset)' != 'v143'" Text="DBE remote adapter currently requires the explicitly configured v143 toolchain." />
    <Error Condition="'$(DBEConfiguredCompiler)' == '' Or '$(DBESelectedCompiler)' != '$(DBEConfiguredCompiler)'" Text="The project-selected compiler differs from this adapter configuration. Create an adapter for the selected toolchain." />
    <DbeInputInventory Condition="'$(DBEIncrementalTracking)' == 'true'" ProjectDirectory="$(MSBuildProjectDirectory)"
        NativeLocal="$([System.String]::Equals('$(DBELocal)', 'true'))"
        StateFile="$(IntDir)dbe-input-inventory.txt" Sources="@(ClCompile)" ProjectReferences="@(DBEDeclaredReference)" TrackerDirectory="$(TLogLocation)"
        ObservedInputExclusions="$(ExcludePath);$(SystemRoot);$(windir);$([System.IO.Path]::GetDirectoryName('$(DBEConfiguredCompiler)'));$(DBERuntimeDirectories)"
        SearchRoots="$(DBENativeInputRoots);$(IncludePath);$(ExternalIncludePath);@(ClCompile->'%(AdditionalIncludeDirectories)');@(ClCompile->'%(ExternalIncludePath)')"
        ExcludedRoots="$(IntDir);$(OutDir);$(DBEAdapterDirectory);$(DBEStateDirectory);$(DBELeaseDirectory)"
        TrackedRuntimeRoots="$(DBEAdapterDirectory);$(DBEStateDirectory);$(DBELeaseDirectory)"
        RuntimeInputs="$(DBEAdapterDirectory)\msbuild.json;$(DBEAdapterDirectory)\dbe-remote-cl.exe;$(DBEAdapterDirectory)\dbe-worker.dll;$(DBEAdapterDirectory)\DBE.Remote.targets;$(DBEAdapterDirectory)\DbeInputInventory.cs;$(DBELocalInputs)">
      <Output TaskParameter="Changed" PropertyName="DBEInputMembershipChanged" />
      <Output TaskParameter="Fingerprint" PropertyName="DBEInputFingerprint" />
      <Output TaskParameter="TrackedExclusions" ItemName="DBETrackedExclusions" />
      <Output TaskParameter="InvalidatedObjects" ItemName="DBEInvalidatedObjects" />
    </DbeInputInventory>
    <!-- Retire only objects both declared and observed before invalidating
         the MP command. On failure an old object must not survive the pass. -->
    <Delete Files="@(DBEInvalidatedObjects);$(TLogLocation)dbe-remote-cl.command.1.tlog"
            Condition="'$(DBELocal)' == 'true' and '$(DBEInputMembershipChanged)' == 'true' and '$(TLogLocation)' != ''" />
    <ItemGroup>
      <ClCompile Update="@(ClCompile)">
        <!-- Hybrid/Local preserve native content/command tracking and invalidate
             include membership changes. Other modes keep full revalidation. -->
        <MinimalRebuildFromTracking Condition="'$(DBEIncrementalTracking)' != 'true' Or ('$(DBEInputMembershipChanged)' == 'true' And '$(DBELocal)' != 'true')">false</MinimalRebuildFromTracking>
        <ExcludedInputPaths>@(DBETrackedExclusions);%(ClCompile.ExcludedInputPaths)</ExcludedInputPaths>
        <DeleteOutputBeforeExecute Condition="'$(DBELocal)' != 'true'">false</DeleteOutputBeforeExecute>
        <DeleteOutputBeforeExecute Condition="'$(DBELocal)' == 'true'">true</DeleteOutputBeforeExecute>
      </ClCompile>
    </ItemGroup>
  </Target>
  <Target Name="DBECommitInputInventory" AfterTargets="ClCompile" Condition="'$(DBEEnabled)' == 'true' And '$(DBEIncrementalTracking)' == 'true' And '$(DBEInputFingerprint)' != ''">
    <WriteLinesToFile File="$(IntDir)dbe-input-inventory.txt" Lines="$(DBEInputFingerprint)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup><FileWrites Include="$(IntDir)dbe-input-inventory.txt" /></ItemGroup>
  </Target>
  <Target Name="DBECollectCompilerSymbols" AfterTargets="ClCompile" BeforeTargets="Lib;Link" Condition="'$(DBEEnabled)' == 'true'">
    <ItemGroup>
      <DBECompilerSymbols Include="$(IntDir)dbe-*.pdb" />
      <FileWrites Include="@(DBECompilerSymbols)" />
    </ItemGroup>
    <!-- Objects inside static libraries need their type-server PDB next to the
         library when a dependent project links it. Names are unique attempts. -->
    <Copy SourceFiles="@(DBECompilerSymbols)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="'@(DBECompilerSymbols)' != ''">
      <Output TaskParameter="CopiedFiles" ItemName="FileWrites" />
    </Copy>
  </Target>
</Project>
